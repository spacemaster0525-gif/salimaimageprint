<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="SalimaPrint" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Impression USB directe (PCL / ESC-POS)" />

    <Button
        android:id="@+id/buttonDetect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Détecter l imprimante USB" />

    <TextView
        android:id="@+id/textPrinterInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Aucune imprimante détectée" />

    <RadioGroup
        android:id="@+id/radioLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/radioAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تلقائي"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioPcl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PCL" />

        <RadioButton
            android:id="@+id/radioEscPos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESC/POS" />

        <RadioButton
            android:id="@+id/radioCapt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPT (Canon)" />

        <RadioButton
            android:id="@+id/radioMf3010"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MF3010" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/checkDither"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tramage (photos) — MF3010" />

    <Button
        android:id="@+id/buttonPickImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Choisir une image à imprimer" />

    <TextView
        android:id="@+id/textSelectedFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Aucun fichier sélectionné" />

    <Button
        android:id="@+id/buttonPrint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Imprimer" />

    <Button
        android:id="@+id/buttonReplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Replay test.pcapng (MF3010)" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="الطباعة عبر الشبكة (LPR - جسر Windows)" />

    <EditText
        android:id="@+id/editServerIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="عنوان IP لجهاز Windows (مثال: 192.168.1.10)"
        android:inputType="text" />

    <EditText
        android:id="@+id/editQueueName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="اسم مشاركة الطابعة (مثال: CanonLBP6030)"
        android:inputType="text" />

    <Button
        android:id="@+id/buttonPrintLpr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="طباعة عبر الشبكة (LPR)" />

    <TextView
        android:id="@+id/textLprStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
